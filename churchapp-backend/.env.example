PORT=4000
# ⚠️ OBLIGATOIRE en production : définir une valeur secrète aléatoire, jamais la valeur par défaut
JWT_SECRET=votre_secret_jwt_tres_long_et_aleatoire_ici
JWT_EXPIRES_IN=7d

# --- Base de données ---
# Production (Render + Neon) : PostgreSQL Neon fourni par le dashboard Neon
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Développement local : SQLite (décommenter pour ignorer DATABASE_URL)
# DB_STORAGE=./data/churchapp.sqlite

# --- CORS : URL(s) du frontend autorisées, séparées par virgule ---
# Production (Vercel) : https://votre-app.vercel.app
# Dev local : http://localhost:5173
CORS_ORIGIN=https://votre-app.vercel.app,http://localhost:5173

# --- E-mails : Gmail SMTP (non utilisés : pas d'OTP ni d'e-mail dans l'app) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=ton.email@gmail.com
SMTP_PASS=mot-de-passe-applicatif

# --- SMS : ZAVU.dev (non utilisés) ---
ZAVU_API_KEY=ta_cle_zavu
ZAVU_SMS_FROM=ChurchApp
